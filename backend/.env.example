PORT=4000
SARVAM_API_KEY=
SARVAM_API_BASE=https://api.sarvam.ai
FIREWORKS_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=fireworks/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1024

# RazorpayX payouts (test mode) — optional; payout route returns 503 if unset
RAZORPAY_MOCK=1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Admin SDK — required for the payout/webhook routes.
# Base64-encoded JSON of the service-account key.
FIREBASE_SERVICE_ACCOUNT=
